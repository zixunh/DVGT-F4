  "coordinate_contract": {
    "ego_world": "FLU, meters",
    "camera": "OpenCV RDF, rectified pinhole",
    "quaternion": "wxyz",
    "depth": "camera z-depth; rendered range is camera radial distance",
    "relative_pose": "previous ego to current ego; world pose accumulates the inverse"
  },
  "implemented": [
    "strict official checkpoint load including original pose and point heads",
    "persistent bounded per-stream KV and ego-token cache",
    "four-layer feature pyramid and semantic head",
    "projected multi-camera 3D detection with velocity",
    "local binary/semantic occupancy and auxiliary BEV supervision",
    "causal class-gated Kalman/Hungarian tracker",
    "actor-local and static-world Gaussian maps with count, radius and lifetime budgets",
    "independent Gaussian depth residual, attributes, sky cubemap and camera affine",
    "held-out-view differentiable static/dynamic reconstruction; optional LPIPS and normal supervision",
    "reference and CUDA gsplat backends with matched pixel-center convention",
    "lazy per-frame JSONL input and per-frame output writing",
    "perception, Gaussian warmup and joint training; adapter checkpoints",
    "optional last-block fine-tuning with detached past state",
    "local PAI offline f-theta rectification with reference-polynomial inversion and ego masks",
    "streaming ZIP member access and named Draco per-point timestamp decoding",
    "single-past-sweep ego-motion-compensated sparse z-depth and conservative binary occupancy",
    "PAI 12-class cuboid autolabels, stable track IDs and masked absolute-velocity supervision",
    "held-out future RGB targets with consistent world poses and moving-box targets",
    "PAI train/test and Foundation4D evaluation exclusion guards",
    "per-task training provenance and no weight decay on absent semantic classifiers"
  ],
